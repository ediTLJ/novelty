<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Activity-level theme used only for window chrome (status / nav bars,
        splash). All actual UI is drawn by Jetpack Compose via NoveltyTheme.
    -->
    <style name="App.Theme.Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/grey</item>
        <item name="android:navigationBarColor">@color/nav_grey</item>
        <item name="android:colorBackground">@color/grey</item>
    </style>
</resources>
